# Quorum-AI Environment Configuration
# -----------------------------------
# Copy this file to .env and fill in the required values.
# .env is gitignored and should never be committed.
#
# For production on Fly.io: use `fly secrets set KEY=value` instead of
# this file. The Dockerfile does not COPY .env into the image.
# See DEPLOY.md for the full deployment runbook.
#
# Three capabilities are optional and each is gated differently. Only ONE of
# them is a boolean flag, which is why "is the key set?" and "is it on?" are
# not the same question:
#
#   Live LLM execution — needs the FLAG *and* a key
#       OPENROUTER_LIVE_EXECUTION_ENABLED=true  AND  OPENROUTER_API_KEY=...
#   Web search (Tavily) — no flag; a non-empty key alone turns it on
#       TAVILY_API_KEY=...
#   LLM-as-judge (Layer B) — no flag; TWO values, both non-empty
#       QUORUM_EVAL_JUDGE_API_KEY=...  AND  QUORUM_EVAL_JUDGE_MODEL_ID=...
#
# Web search and the judge are PAID. With none of these set, the app runs
# fully in local-simulation mode and costs nothing.
#
# EVERY field of Settings is listed below, and every name listed below is
# either a Settings field or a name some `os.environ` call in src/ actually
# reads. Both directions are gated by tests/test_doc_gate_consistency.py
# (Part E / E2) — an undocumented field and a documented-but-dead knob each
# turn it red, and the example VALUES are pinned to the code's defaults too.
# Settings has no env_prefix, so a variable's name is simply its field name
# uppercased.
#
# Note "below": this header is prose and the gate does not read it, so a knob
# mentioned only up here does NOT count as documented.
#
# Production requirements (when RUNTIME_ENVIRONMENT=production):
#   - SESSION_COOKIE_SECURE must be true
#   - ACCOUNT_LEGACY_HEADER_ENABLED must be false
#   - QUORUM_TOKEN_SECRET must be set to a stable value (multi-instance)

# --- Core Application Settings -----------------------------------------------

# Application name shown in UI and headers
APP_NAME=Quorum-AI

# Runtime environment: local, staging, or production
# Controls security defaults and validation behavior.
#
# THE VARIABLE IS RUNTIME_ENVIRONMENT, not ENVIRONMENT. This file said
# `ENVIRONMENT=` until 2026-08-05 and nothing read it: Settings sets
# extra="ignore", so an ENVIRONMENT= line was silently discarded. MEASURED —
# a .env containing `ENVIRONMENT=production` produced runtime_environment
# `local` and session_cookie_secure `False`, i.e. an operator hardening a
# deployment from this file got LOCAL security defaults and
# validate_production_environment() never fired. (Production was never
# exposed: fly.toml sets both names.)
RUNTIME_ENVIRONMENT=local

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- OpenRouter Configuration (REQUIRED FOR LIVE EXECUTION) -----------------

# OpenRouter API key - REQUIRED for live provider calls
# Get your key at: https://openrouter.ai/keys
# Without this, the app runs in local-simulation mode only
OPENROUTER_API_KEY=

# Enable/disable live execution against real providers
# Set to true for live calls, false for simulation mode
OPENROUTER_LIVE_EXECUTION_ENABLED=false

# Base URL for OpenRouter API (rarely needs to change)
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# Application URL sent to OpenRouter in requests
# Should be your actual public URL in production (for tracking/support)
OPENROUTER_APP_URL=http://localhost:18084

# Application title sent to OpenRouter
OPENROUTER_APP_TITLE=Quorum AI

# Request timeout in seconds
OPENROUTER_TIMEOUT_SECONDS=8.0

# How often the background credential probe re-checks the key after startup
# (seconds). The check is auth-only and costs zero tokens. Must be > 0 and
# finite: 0 busy-spins a live socket call and a negative or infinite value
# silently kills the probe thread, which is why both are rejected at startup.
KEY_AUTH_REPROBE_INTERVAL_SECONDS=1800.0

# --- Web search (Tavily) — OPTIONAL, turns on by KEY PRESENCE alone ----------

# Tavily API key. There is no separate on/off flag: setting a non-empty key
# IS what enables real web search. Absent (the default), the fallback source
# path keeps its deterministic local-simulation stub, so CI stays hermetic and
# free. Tavily is a PAID API — leaving this unset costs nothing.
TAVILY_API_KEY=

# Base URL for the Tavily API (rarely needs to change)
TAVILY_API_BASE_URL=https://api.tavily.com

# Web results requested per fallback search. These attach as is_fallback=true
# sources and do NOT count toward the model's own citation-coverage metric.
TAVILY_MAX_RESULTS=5

# Tavily request timeout in seconds
TAVILY_TIMEOUT_SECONDS=8.0

# --- LLM-as-judge (Layer B) — OPTIONAL, PAID, needs BOTH values -------------

# The optional LLM-as-judge needs TWO values, not one: a key AND a pinned
# model id. A key on its own runs NO judge — verdicts from different models
# are not comparable, so the id is configuration rather than a default.
# Absent (the default), no judge call is ever made and the deterministic
# Layer-A TrustScore is byte-identical with the judge on or off.
#
# COSTS MONEY. Since #265 the pre-run spend cap (`max_cost_usd`, the "up to $Y"
# figure the user approves) PRICES the judge whenever both values below are set,
# so switching it on raises that figure rather than silently exceeding it.
#
# Still UNDER-REPORTED in one place. Issue #216: a judge call fired while
# serving GET /v1/query-runs/{id} never reaches the daily spend ledger, because
# no GET route writes to it. A run's FIRST judge call is booked (it happens
# during terminal persistence, on the POST path); a RE-dispatch after the
# verdict memo is evicted or the process restarts is not. Enabling the judge
# is an explicit human decision — the verdict is also advisory and
# UNCALIBRATED until the golden set exists. Whether it is on is reported by
# /status.judge_enabled (state only, never these values).
QUORUM_EVAL_JUDGE_API_KEY=
QUORUM_EVAL_JUDGE_MODEL_ID=

# Token cap for one judge response. The output contract is a small strict-JSON
# object; anything longer than this is malformed by definition.
QUORUM_EVAL_JUDGE_MAX_TOKENS=1024

# --- Authentication & Security -----------------------------------------------

# Required in production: set to true when RUNTIME_ENVIRONMENT=production
# Ensures session cookies are only sent over HTTPS
SESSION_COOKIE_SECURE=false

# Legacy X-Account-Id header support for testing
# MUST be set to false when RUNTIME_ENVIRONMENT=production
ACCOUNT_LEGACY_HEADER_ENABLED=true

# Per-IP session rate-limit overrides. BOTH are LOCAL-ONLY: the app REFUSES
# TO START if either is set while RUNTIME_ENVIRONMENT is not "local". They
# exist because every e2e browser context shares one loopback IP, so a full
# run exhausts the real limits and measures the limiter instead of the
# product. Leave unset outside the test lanes.
#
#   SESSION_RATE_LIMIT_PER_MINUTE — the in-memory per-IP burst bucket
#                                   (10/min in production, tightened from 30
#                                   by issue #100 §2.4). 1..10000.
#   SESSION_MINT_CAP_OVERRIDE     — the DURABLE per-IP daily mint cap
#                                   (2 per 24h in production). 1..10000.
#
# 0 or negative is rejected for both: a zero bucket locks every IP out, it
# never means "unlimited".
# SESSION_RATE_LIMIT_PER_MINUTE=600
# SESSION_MINT_CAP_OVERRIDE=600

# Interactive API docs exposure (/docs, /openapi.json).
# Leave UNSET to derive from RUNTIME_ENVIRONMENT: docs are served ONLY in local dev
# and are off-by-default in BOTH staging and production, so an internet-reachable
# box never exposes the unauthenticated schema unless you opt in. Set to true to
# force them on (e.g. a locked-down staging box), or false to force them off.
# /health and /ready are always public and never gated by this flag.
# EXPOSE_API_DOCS=true

# Token secret for confirmation tokens (required for production/multi-instance)
# Generate a strong random value: openssl rand -hex 32
# If not set, a per-process random value is used (tokens break on restart)
# QUORUM_TOKEN_SECRET=

# --- Error Tracking (Optional) -----------------------------------------------

# Sentry DSN for error tracking. Get from:
#   https://sentry.io/settings/[org]/projects/[project]/keys/
# When set, unhandled exceptions and 10% of performance traces
# are reported. When unset, the app runs unaffected.
# SENTRY_DSN=

# --- Pipeline Tuning ---------------------------------------------------------

# Synthetic delay between stages (milliseconds) - for testing visibility
# Production may set this to 0 for maximum performance
STAGE_DELAY_MS=5

# Total wall-clock budget for ONE query run, in seconds (NFR-001/NFR-004).
# On breach the run degrades to an honest partial result (status timed_out)
# carrying every slot completed so far — never a bare 500. Must be finite,
# > 0 and <= 3600; 0 must never mean "unlimited".
QUORUM_RUN_DEADLINE_SECONDS=180.0

# --- Durable-store reconnect -------------------------------------------------

# Whether a background attempt may re-open a SQLite sink that failed to open
# at boot (or went read-only mid-life). Default true: with it off, a transient
# lock at boot disables the per-account 24h spend cap for the WHOLE process
# life, with no way back short of a restart. Turning it off also disables the
# fail-closed spend cap below, since that only blocks once a reopen has been
# tried and failed.
STORE_RECONNECT_ENABLED=true

# Seconds between reopen attempts. Long enough that a burst during an outage
# does not hammer the ~5s lock-open cost this keeps off the request path,
# short enough that a recovered volume is usable within a minute. Must be > 0.
STORE_RECONNECT_COOLDOWN_SECONDS=60.0

# --- Cost Guardrails ---------------------------------------------------------

# Soft threshold in USD - shows warning but allows confirmation
SOFT_THRESHOLD_USD=0.15

# Hard limit in USD - blocks queries exceeding this cost
HARD_LIMIT_USD=0.25

# Posture when the per-account 24h spend ledger cannot be trusted (the store
# is gone or its writes are failing) and a reopen has already been tried:
# refuse the priced request (true) or allow it and log loudly (false).
#
# DEFAULT false — fail OPEN — and that default is the decision, not an
# oversight (ADR-0004). Failing open is bounded: the in-memory cumulative rail
# still binds each account at ~HARD_LIMIT_USD and new accounts need sessions.
# Failing closed refuses every visitor for as long as the fault lasts. Switch
# this on only as a deliberate human choice.
DAILY_CAP_FAIL_CLOSED=false

# NOTE: the GLOBAL daily spend ceiling ($5.00) is a HARDCODED CONSTANT in
# src/product_app/costs.py — there is deliberately no environment variable
# for it. /status reports it as global_daily_ceiling_usd.

# --- Cost Estimation ---------------------------------------------------------

# The pre-run estimate SPENDS NO TOKENS: it prices a realistic token model per
# billed call against the cached catalog rates and makes no completion call.
# (It is not literally offline — a cold or TTL-expired catalog cache costs one
# free metadata fetch of the model list.) Calibrated slightly conservative on
# purpose — the cost guardrail keys off the estimate, so it must fail safe.
#
# (The pre-#16 knobs COST_OUTPUT_TOKEN_MULTIPLIER, COST_INNER_CALL_MULTIPLIER
# and COST_INNER_CALL_CAP_USD were documented here until 2026-08-05 and read
# by nothing. They are gone; the fields below are what the estimator really
# uses.)

# Fixed system-prompt overhead carried by every billed call, in tokens
COST_SYSTEM_PROMPT_TOKENS=350

# Prompt tokens the ":online" web-search suffix injects into each SEARCHING
# initial-answer call. Applied per slot, only when that slot has search on.
COST_WEB_SEARCH_CONTEXT_TOKENS=2000

# Flat per-request fee for the ":online" web-search plugin, per searching
# call. DELIBERATELY 0.0 AND PERMANENTLY OFF (AC-037, issue #18): the fee is
# real (~$0.02/request) but the estimate already runs above the measured
# token cost, so the guardrail stays fail-safe without it. Raising it shifts
# the CONFIRM/BLOCK bands. Leave at 0.0.
COST_WEB_SEARCH_REQUEST_FEE_USD=0.0

# Output-token floor for one initial answer, and how much it lengthens per
# token of query: output = COST_INITIAL_OUTPUT_TOKENS + (rate x query_tokens)
COST_INITIAL_OUTPUT_TOKENS=700
COST_OUTPUT_TOKENS_PER_QUERY_TOKEN=0.5

# Output-token floor for one debate round, and the enforced per-round cap the
# fail-safe max_cost_usd bound prices against. The cap MUST stay in sync with
# debate.DEBATE_ROUND_MAX_TOKENS, the value the live call actually enforces.
COST_DEBATE_OUTPUT_TOKENS=400
COST_DEBATE_OUTPUT_TOKENS_CAP=2000

# Output-token floor for one synthesis section call, and how many section
# calls are PRICED. Both the point estimate and the fail-safe bound price all
# COST_SYNTHESIS_SECTIONS of them.
#
# COST_SYNTHESIS_SECTIONS is a PRICING knob only. The real fan-out lives in
# synthesis.py and does not read it — lowering this changes the estimate, not
# the pipeline, which is a way to make the cost guardrail under-count.
COST_SYNTHESIS_OUTPUT_TOKENS=3000
COST_SYNTHESIS_SECTIONS=5

# Hard per-call output cap for the four initial answers, enforced as
# max_tokens on the live call. Without it initial-answer output is unbounded,
# so a verbose prompt can cost far more than any pre-run estimate — defeating
# the cost guardrail.
INITIAL_ANSWER_MAX_TOKENS=2000

# --- Model Selection ---------------------------------------------------------

# Model used for debate rounds (cheap, fast, good at critique; not seen by the user)
DEBATE_MODEL_ID=anthropic/claude-haiku-4.5

# Model used for final synthesis (the only stage the user reads; see ADR-0028)
SYNTHESIS_MODEL_ID=openai/gpt-5-mini

# --- Catalog Fetcher ---------------------------------------------------------

# Catalog cache TTL in seconds (6 hours default)
CATALOG_CACHE_TTL_SECONDS=21600.0

# Catalog fetch timeout in seconds
CATALOG_FETCH_TIMEOUT_SECONDS=4.0
