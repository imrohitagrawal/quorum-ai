.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.coverage
# Two DIFFERENT artifacts, both needed:
#   `.coverage 2`, `.coverage 3`, ... — macOS duplicate-name copies.
#   `.coverage.<host>.<pid>.<rand>`   — one per worker from pytest-cov's
#     parallel mode. Only `.coverage *` was listed, and it does NOT match
#     these (no space), so every run left dozens of untracked files behind.
.coverage *
.coverage.*
htmlcov/
.env
.env.*
!.env.example
.DS_Store
dist/
build/
*.egg-info/

# Agent / IDE / working-notes state (local only)
.codex/
.claude/
.vscode/
.idea/
*.swp
HANDOFF-*.md

# Local verification artifacts
.playwright-mcp/
quorum-final-run.png

# Local data + feedback audit outputs (kept on disk, not in git)
.data/
feedback/audit-*.json

# E2E test artifacts
e2e/test-results/
e2e/playwright-report/
e2e/node_modules
e2e/results.xml

# Temporary files created by the test harness
temp-artifacts/


# mutmut copies the whole project into ./mutants/ for `make mutation-baseline`.
# It is a build artifact: never committed, never linted, never type-checked.
mutants/

# Throwaway human-review captures (master plan §11 "Cleanup owed"):
# review specs assert little and only exist to produce PNGs for a human to
# look at. They are NOT registered in any CI lane and must never gate.
e2e/review-screenshots/
e2e/tests/review/
